use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
?>

<section
    class="bb-pdp-reviews"
    data-pdp-defer-paint
    aria-label="<?= $escaper->escapeHtmlAttr(__('Customer reviews')) ?>"
>
    <div class="bb-pdp-reviews__container">
        <?php
        /*
        |--------------------------------------------------------------------------
        | Shopper Approved review-page widget (commented out — using static carousel)
        |--------------------------------------------------------------------------
        |
        | To restore: change `if (false)` below to `if (true)`, and set the static
        | block's `if (true)` to `if (false)`.
        */
        ?>
        <?php if (false): ?>
        <div
            class="bb-pdp-reviews__defer"
            x-data="{
                visible: false,
                inView: false,
                scrolled: false,
                heroSettled: window.matchMedia('(min-width: 1200px)').matches,
                tryReveal() {
                    if (window.matchMedia('(min-width: 1200px)').matches) {
                        if (this.inView) {
                            this.visible = true;
                        }
                        return;
                    }

                    if (this.heroSettled && this.inView && this.scrolled) {
                        this.visible = true;
                    }
                }
            }"
            x-init="
                if (!heroSettled) {
                    const onScroll = () => {
                        if (window.scrollY > 60) {
                            scrolled = true;
                            tryReveal();
                        }
                    };

                    window.addEventListener('scroll', onScroll, { passive: true });
                    onScroll();

                    const settle = () => {
                        heroSettled = true;
                        tryReveal();
                        window.setTimeout(() => {
                            scrolled = true;
                            tryReveal();
                        }, 2500);
                    };

                    if (document.readyState === 'complete') {
                        settle();
                    } else {
                        window.addEventListener('load', settle, { once: true });
                    }
                }
            "
            x-intersect.once="
                if (window.matchMedia('(max-width: 1199px)').matches) {
                    inView = true;
                    tryReveal();
                }
            "
            x-intersect.once.margin.300px="
                if (window.matchMedia('(min-width: 1200px)').matches) {
                    inView = true;
                    visible = true;
                }
            "
            :class="{ 'bb-pdp-reviews__defer--loaded': visible }"
        >
            <div
                class="bb-pdp-reviews__placeholder"
                x-show="!visible"
                aria-hidden="true"
            ></div>

            <template x-if="visible">
                <div class="bb-pdp-reviews__widget">
                    <style>
                        /* Shopper Approved review page — Hyvä/Tailwind sets svg { display: block } */
                        #SA_review_wrapper svg {
                            display: inline !important;
                            vertical-align: middle !important;
                            width: auto !important;
                            height: auto !important;
                            max-width: none !important;
                        }

                        #SA_review_wrapper .SA__review_widget {
                            display: flex !important;
                            flex-wrap: wrap !important;
                            justify-content: space-between !important;
                            align-items: center !important;
                            gap: 10px !important;
                            width: 100% !important;
                        }

                        #SA_review_wrapper .SA__review_widget .SA__review_widget_item.middle {
                            flex: 1 1 auto !important;
                            min-width: 240px !important;
                        }

                        #SA_review_wrapper .SA__review_widget .SA__review_widget_item .SA__review_content .SA__review_bar {
                            display: flex !important;
                            flex-direction: row !important;
                            align-items: center !important;
                            position: relative !important;
                        }

                        #SA_review_wrapper .SA__review_widget .SA__review_widget_item .SA__review_content .SA__review_bar_label {
                            display: inline-flex !important;
                            align-items: center !important;
                            flex: 0 0 50px !important;
                            position: absolute !important;
                            left: 0 !important;
                            white-space: nowrap !important;
                            line-height: 13px !important;
                        }

                        #SA_review_wrapper .SA__review_widget .SA__review_widget_item .SA__review_content .SA__review_bar_label svg {
                            display: inline !important;
                            vertical-align: middle !important;
                            height: 13px !important;
                            width: auto !important;
                        }

                        #SA_review_wrapper .SA__more_review {
                            text-align: right !important;
                        }

                        #SA_review_wrapper .SA__more_review a,
                        #SA_review_wrapper .SA__more_review .sa-bottom-logo,
                        #SA_review_wrapper .SA__more_review .sa-bottom-arrow {
                            display: inline !important;
                            vertical-align: middle !important;
                        }

                        #SA_review_wrapper .SA__more_review svg {
                            max-width: 25px !important;
                        }
                    </style>

                    <div id="SA_review_wrapper" role="region" tabindex="-1" aria-label="<?= $escaper->escapeHtmlAttr(__('Customer reviews widget')) ?>"></div>

                    <script type="text/javascript">
                        (function () {
                            var sa_interval = 5000;

                            if (typeof saLoadScript !== 'function') {
                                function saLoadScript(src) {
                                    var js = window.document.createElement('script');
                                    js.src = src;
                                    js.type = 'text/javascript';
                                    document.getElementsByTagName('head')[0].appendChild(js);
                                }
                            }

                            function loadShopperApprovedReviews() {
                                if (typeof shopper_first === 'undefined') {
                                    saLoadScript('https://www.shopperapproved.com/widgets/42172/merchant/review-page/default.js');
                                }
                                shopper_first = true;
                            }

                            function scheduleShopperApprovedLoad() {
                                var run = function () {
                                    if ('requestIdleCallback' in window) {
                                        requestIdleCallback(loadShopperApprovedReviews, { timeout: 3000 });
                                    } else {
                                        window.setTimeout(loadShopperApprovedReviews, 100);
                                    }
                                };

                                if (window.matchMedia('(max-width: 1199px)').matches) {
                                    window.setTimeout(run, 800);
                                } else {
                                    var preconnect = document.createElement('link');
                                    preconnect.rel = 'preconnect';
                                    preconnect.href = 'https://www.shopperapproved.com';
                                    document.head.appendChild(preconnect);
                                    run();
                                }
                            }

                            if (window.matchMedia('(max-width: 1199px)').matches) {
                                if (document.readyState === 'complete') {
                                    scheduleShopperApprovedLoad();
                                } else {
                                    window.addEventListener('load', scheduleShopperApprovedLoad, { once: true });
                                }
                            } else {
                                scheduleShopperApprovedLoad();
                            }
                        })();
                    </script>
                </div>
            </template>
        </div>
        <?php endif; ?>

        <?php
        /*
        |--------------------------------------------------------------------------
        | Static carousel (active — same as homepage Customers Review)
        |--------------------------------------------------------------------------
        |
        | To disable: change `if (true)` below to `if (false)`, and enable the
        | Shopper Approved block above (`if (false)` → `if (true)`).
        */
        ?>
        <?php if (true): ?>
        <?php
        /** @var CustomerReviews $customerReviews */
        $customerReviews = $viewModels->require(CustomerReviews::class);
        $reviews = $customerReviews->getReviews();
        $paginationCount = $customerReviews->getPaginationCount();
        $starPath = 'M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.77l-4.94 2.6.94-5.5-4-3.9 5.53-.8L10 1.5z';
        ?>
        <div
            class="home-customers-review bb-pdp-reviews__static-carousel"
            aria-labelledby="pdp-customers-review-heading"
        >
            <header class="home-customers-review__header">
                <h2 id="pdp-customers-review-heading" class="home-customers-review__title">
                    <?= $escaper->escapeHtml(__('Customers Review')) ?>
                </h2>
                <hr class="home-customers-review__divider" aria-hidden="true">
            </header>

            <div x-data="{ activeSlide: 0 }">
                <div
                    class="home-customers-review__track"
                    role="list"
                    @scroll.debounce.100ms="
                        const card = $el.querySelector('.home-customers-review__card');
                        if (!card) return;
                        activeSlide = Math.min(
                            <?= (int) ($paginationCount - 1) ?>,
                            Math.round($el.scrollLeft / (card.offsetWidth + 16))
                        );
                    "
                >
                    <?php foreach ($reviews as $review): ?>
                        <article class="home-customers-review__card" role="listitem">
                            <div
                                class="home-customers-review__stars"
                                aria-label="<?= $escaper->escapeHtmlAttr(__('%1 out of 5 stars', $review['rating'])) ?>"
                            >
                                <?php for ($i = 0; $i < $review['rating']; $i++): ?>
                                    <svg viewBox="0 0 20 20" aria-hidden="true">
                                        <path d="<?= $escaper->escapeHtmlAttr($starPath) ?>"/>
                                    </svg>
                                <?php endfor; ?>
                            </div>
                            <p class="home-customers-review__author">
                                <?= $escaper->escapeHtml(__('- %1', $review['author'])) ?>
                            </p>
                            <h3 class="home-customers-review__headline">
                                <?= $escaper->escapeHtml(__($review['headline'])) ?>
                            </h3>
                            <p class="home-customers-review__text">
                                <?= $escaper->escapeHtml(__($review['text'])) ?>
                            </p>
                            <a href="<?= $escaper->escapeUrl($review['url']) ?>"
                               class="home-customers-review__read-more">
                                <?= $escaper->escapeHtml(__('Read more')) ?>
                                <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M18 13v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                                    <path d="M15 3h6v6"/>
                                    <path d="M10 14 21 3"/>
                                </svg>
                            </a>
                        </article>
                    <?php endforeach; ?>
                </div>

                <ul class="home-customers-review__pagination" aria-label="<?= $escaper->escapeHtmlAttr(__('Review slides')) ?>">
                    <?php for ($i = 0; $i < $paginationCount; $i++): ?>
                        <li>
                            <button
                                type="button"
                                class="home-customers-review__dot"
                                :class="{ 'is-active': activeSlide === <?= (int) $i ?> }"
                                :aria-current="activeSlide === <?= (int) $i ?> ? 'true' : null"
                                aria-label="<?= $escaper->escapeHtmlAttr(__('Slide %1', $i + 1)) ?>"
                                @click="
                                    activeSlide = <?= (int) $i ?>;
                                    const track = $el.closest('.home-customers-review').querySelector('.home-customers-review__track');
                                    const card = track?.querySelector('.home-customers-review__card');
                                    if (track && card) {
                                        track.scrollTo({ left: card.offsetWidth * <?= (int) $i ?> + (16 * <?= (int) $i ?>), behavior: 'smooth' });
                                    }
                                "
                            ></button>
                        </li>
                    <?php endfor; ?>
                </ul>
            </div>
        </div>
        <?php endif; ?>
    </div>
</section>
