<?php

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\ProductAttributes;
use Hyva\Theme\ViewModel\ProductPage;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var ProductPage $productViewModel */
$productViewModel = $viewModels->require(ProductPage::class);

/** @var ProductAttributes $attributesViewModel */
$attributesViewModel = $viewModels->require(ProductAttributes::class);

$product = $productViewModel->getProduct();
$warrantyDefault = (string) ($block->getData('warranty_default') ?: '30-days');

$specRows = [
    ['code' => 'manufacturer', 'label' => (string) __('Manufacturer')],
    ['code' => 'sku', 'label' => (string) __('Manufacturer Part No.')],
    ['code' => 'condition', 'label' => (string) __('Condition')],
];

$rows = [];
foreach ($specRows as $specRow) {
    $attributeData = $attributesViewModel->getAttributeData($specRow['code'], $product);
    $value = trim(strip_tags((string) ($attributeData['value'] ?? '')));

    if ($value === '' || $value === 'No') {
        continue;
    }

    $rows[] = [
        'label' => $specRow['label'],
        'value' => $value,
        'code' => $specRow['code'],
    ];
}

$rows[] = [
    'label' => (string) __('Warranty'),
    'value' => $warrantyDefault,
    'code' => 'warranty',
];

if (!$rows) {
    return;
}

$brand = trim(strip_tags($attributesViewModel->getValue($product, 'manufacturer')));
$sku = $product->getSku();
$overviewTitle = $brand && $sku
    ? $brand . ' ' . $sku
    : $product->getName();
?>

<div class="bb-pdp-overview">
    <p class="bb-pdp-overview__lead">
        <?= $escaper->escapeHtml(
            __(
                'The %1 is available at BulkDevices. Contact our customer service team for more information.',
                $overviewTitle
            )
        ) ?>
    </p>
    <div class="bb-pdp-overview__table-wrap" id="product-attributes">
        <table class="bb-pdp-overview__table">
            <tbody>
            <?php foreach ($rows as $row): ?>
                <tr class="bb-pdp-overview__row attribute-<?= $escaper->escapeHtmlAttr($row['code']) ?>">
                    <th class="bb-pdp-overview__label" scope="row"><?= $escaper->escapeHtml($row['label']) ?></th>
                    <td class="bb-pdp-overview__value"><?= $escaper->escapeHtml($row['value']) ?></td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    </div>
</div>
