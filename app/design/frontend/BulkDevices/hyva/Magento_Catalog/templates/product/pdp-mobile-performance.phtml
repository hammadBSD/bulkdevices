<?php

declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @var Template $block */
?>
<script>
    (function () {
        if (!window.matchMedia('(max-width: 1199px)').matches) {
            return;
        }

        var earlyDeferPatterns = ['top-bar'];
        var lateDeferPatterns = ['footer-top', 'footer-middle', 'popup'];
        var earlyDeferredLinks = [];
        var lateDeferredLinks = [];

        document.querySelectorAll('link[rel="stylesheet"]').forEach(function (link) {
            var href = link.getAttribute('href') || '';

            if (earlyDeferPatterns.some(function (pattern) {
                return href.indexOf(pattern) !== -1;
            })) {
                link.media = 'not all';
                earlyDeferredLinks.push(link);
                return;
            }

            if (lateDeferPatterns.some(function (pattern) {
                return href.indexOf(pattern) !== -1;
            })) {
                link.media = 'not all';
                lateDeferredLinks.push(link);
            }
        });

        function enableStyles(links) {
            links.forEach(function (link) {
                link.media = 'all';
            });
        }

        function afterFirstPaint(callback) {
            if ('requestAnimationFrame' in window) {
                requestAnimationFrame(function () {
                    requestAnimationFrame(callback);
                });
                return;
            }

            window.setTimeout(callback, 0);
        }

        if (earlyDeferredLinks.length) {
            afterFirstPaint(function () {
                enableStyles(earlyDeferredLinks);
            });
        }

        function onPageReady(callback) {
            if (document.readyState === 'complete') {
                callback();
                return;
            }

            window.addEventListener('load', callback, { once: true });
        }

        function collectPaintTargets() {
            document.querySelectorAll('.catalog-product-view .site-footer-top, .catalog-product-view .site-footer-middle').forEach(function (el) {
                el.setAttribute('data-pdp-defer-paint', '');
            });

            return document.querySelectorAll('[data-pdp-defer-paint]');
        }

        var paintGateOpen = false;
        var scrollUnlocked = window.scrollY > 120;
        var loadSettled = document.readyState === 'complete';

        function revealPaintTarget(el) {
            el.classList.add('pdp-paint-ready');
        }

        function maybeOpenPaintGate() {
            if (paintGateOpen || !loadSettled || !scrollUnlocked) {
                return;
            }

            paintGateOpen = true;
            startPaintObserver();
        }

        function onScrollUnlock() {
            if (window.scrollY <= 120) {
                return;
            }

            scrollUnlocked = true;
            maybeOpenPaintGate();
        }

        window.addEventListener('scroll', onScrollUnlock, { passive: true });

        function startPaintObserver() {
            var paintTargets = collectPaintTargets();

            if (!paintTargets.length) {
                return;
            }

            if (!('IntersectionObserver' in window)) {
                paintTargets.forEach(revealPaintTarget);
                return;
            }

            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting || entry.intersectionRatio < 0.05) {
                        return;
                    }

                    revealPaintTarget(entry.target);
                    observer.unobserve(entry.target);
                });
            }, {
                root: null,
                rootMargin: '0px 0px',
                threshold: [0, 0.05, 0.1]
            });

            paintTargets.forEach(function (el) {
                observer.observe(el);
            });
        }

        onPageReady(function () {
            loadSettled = true;
            enableStyles(lateDeferredLinks);

            window.setTimeout(function () {
                scrollUnlocked = true;
                maybeOpenPaintGate();
            }, 2200);

            maybeOpenPaintGate();
        });

        onScrollUnlock();
    })();
</script>
