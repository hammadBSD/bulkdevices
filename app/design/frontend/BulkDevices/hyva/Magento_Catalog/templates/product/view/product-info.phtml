declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\ProductAttributes;
use Hyva\Theme\ViewModel\ProductPage;
use Hyva\Theme\ViewModel\ProductPrice;
use Magento\Catalog\Model\Product;
use Magento\Catalog\Pricing\Price\FinalPrice;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var ProductPage $productViewModel */
$productViewModel = $viewModels->require(ProductPage::class);

/** @var ProductAttributes $attributesViewModel */
$attributesViewModel = $viewModels->require(ProductAttributes::class);

/** @var Product $product */
$product = $productViewModel->getProduct();
$productType = $product->getTypeId();

/** @var ProductPrice $productPriceViewModel */
$productPriceViewModel = $viewModels->require(ProductPrice::class);
$finalPrice = (float) $productPriceViewModel->getPriceValue(FinalPrice::PRICE_CODE, $product);
$isCallForPrice = $finalPrice <= 0;

?>
<div class="card bb-pdp-info min-w-0">
    <?= $block->getChildHtml('product.info.title') ?>

    <div class="bb-pdp-info__meta">
        <dl id="product-details" class="bb-pdp-info__attributes">
            <?php foreach ($block->getAttributes() as $attributeConfig):
                $attribute = $attributesViewModel->getAttributeFromLayoutConfig($attributeConfig); ?>
                <?php if ($value = $attribute['value'] ?? null): ?>
                    <div class="bb-pdp-info__attribute attribute-<?= /* @noEscape */ $attribute['code'] ?: '' ?>">
                        <dt class="bb-pdp-info__attribute-label product-detail-label">
                            <?= $escaper->escapeHtml($attribute['label']) ?>
                        </dt>
                        <dd class="bb-pdp-info__attribute-value product-detail-value">
                            <?= $escaper->escapeHtml($value) ?>
                        </dd>
                    </div>
                <?php endif ?>
            <?php endforeach; ?>
        </dl>

        <div class="bb-pdp-info__availability">
            <span class="bb-pdp-info__attribute-label"><?= $escaper->escapeHtml(__('Availability')) ?></span>
            <?= $block->getChildHtml('product.info.stockstatus') ?>
        </div>

        <?= $block->getChildHtml('alert.urls') ?>
    </div>

    <?= $block->getChildHtml('product.info.form') ?>

    <div class="flex flex-col sm:flex-row items-end my-4 bb-pdp-info__purchase">

        <?php if ($productType === 'bundle'): ?>
            <span class="sr-only">
                <?= $escaper->escapeHtml(__('The price depends on the chosen options')) ?>
            </span>
        <?php endif; ?>

        <?php if (!$isCallForPrice): ?>
            <div class="bb-pdp-info__pricing" role="group" aria-label="<?= $escaper->escapeHtmlAttr(__('Price')) ?>">
                <?= $block->getChildHtml('product.info.price') ?>
                <?= $block->getChildHtml('product.info.savings') ?>
            </div>
        <?php endif; ?>

        <div class="flex gap-2 mt-4 <?= $isCallForPrice ? '' : 'ml-auto' ?> sm:mt-0 bb-pdp-info__actions<?= $isCallForPrice ? ' bb-pdp-info__actions--call-for-price' : '' ?>">
            <?php if ($isCallForPrice): ?>
                <button
                    type="button"
                    class="btn btn-primary bb-pdp-quotation-trigger"
                    aria-haspopup="dialog"
                    data-sku="<?= $escaper->escapeHtmlAttr($product->getSku()) ?>"
                    data-request-type="<?= $escaper->escapeHtmlAttr(__('Request For Quotation')) ?>"
                >
                    <?= $escaper->escapeHtml(__('Request For Quotation')) ?>
                </button>
            <?php elseif ($product->isSaleable()): ?>
                <?= $block->getChildHtml('product.info.quantity') ?>
                <?= $block->getChildHtml('product.info.addtocart') ?>
            <?php endif; ?>
        </div>
    </div>

    <?php if ($product->isSaleable() && !$isCallForPrice && $block->getChildHtml('addtocart.shortcut.buttons')): ?>
        <div class="flex mt-4 justify-end">
            <?= $block->getChildHtml('addtocart.shortcut.buttons') ?>
        </div>
    <?php endif; ?>

    <?php if ($additionalActions = $block->getChildHtml('product.info.additional.actions')): ?>
        <div class="flex mt-4 justify-end">
            <?= /** @noEscape */ $additionalActions; ?>
        </div>
    <?php endif; ?>

    <?php if ($tierPriceBlock = $block->getChildHtml('product.price.tier')): ?>
        <div class="py-4 my-2 tier-price-container">
            <?= /** @noEscape */ $tierPriceBlock ?>
        </div>
    <?php endif; ?>

    <?= $block->getChildHtml('product.info.stockqty') ?>
    <?= $block->getChildHtml('product.info.additional') ?>
</div>
