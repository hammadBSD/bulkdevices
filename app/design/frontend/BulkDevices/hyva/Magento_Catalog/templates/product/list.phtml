declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\CurrentCategory;
use Magento\Catalog\Block\Product\ListProduct;
use Magento\Framework\Escaper;

/** @var ListProduct $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var CurrentCategory $currentCategoryViewModel */

$currentCategoryViewModel = $viewModels->require(CurrentCategory::class);

$mobilePriorityImageCount = 2;
$desktopEagerImageCount = (int) ($block->getData('eager_load_images_count') ?? 4);
$productCollection = $block->getLoadedProductCollection();
$cardBlock = $block->getChildBlock('product.card');
$viewMode = $block->getMode() === 'grid' ? 'grid' : 'list';
$isGrid = $viewMode === 'grid';

?>
<?php if (!$productCollection->count()): ?>
    <div class="bb-plp-empty message info empty">
        <div>
            <?= $escaper->escapeHtml(__('We can\'t find products matching the selection.')) ?>
        </div>
    </div>
<?php elseif ($cardBlock): ?>
    <section
        class="bb-plp-list"
        id="product-list"
        aria-label="<?= $escaper->escapeHtmlAttr(__('Product list')) ?>"
        tabindex="-1"
    >
        <?= $block->getToolbarHtml() ?>
        <?= $block->getAdditionalHtml() ?>
        <div class="bb-plp-list__products products wrapper mode-<?= $escaper->escapeHtmlAttr($viewMode) ?> products-<?= $escaper->escapeHtmlAttr($viewMode) ?>">
            <ul role="list" class="bb-plp-grid<?= $isGrid ? '' : ' bb-plp-grid--list' ?>">
                <?php
                /** @var \Magento\Catalog\Model\Product $product */
                foreach (array_values($productCollection->getItems()) as $i => $product):
                    if ($i < $mobilePriorityImageCount) {
                        $product->setData('image_custom_attributes', [
                            'loading' => 'eager',
                            'fetchpriority' => 'high',
                        ]);
                    } elseif ($i < $desktopEagerImageCount) {
                        $product->setData('image_custom_attributes', [
                            'loading' => 'lazy',
                            'class' => 'bb-plp-img--desktop-eager',
                        ]);
                    } else {
                        $product->unsetData('image_custom_attributes');
                    }
                    ?>
                    <li class="bb-plp-grid__item">
                        <?= $cardBlock
                            ->setData('product', $product)
                            ->setData('view_mode', $viewMode)
                            ->setData('hide_qty_selector', true)
                            ->setData('defer_qty_alpine', $i >= $mobilePriorityImageCount)
                            ->toHtml() ?>
                    </li>
                <?php endforeach; ?>
            </ul>
            <script>
                (function () {
                    if (!window.matchMedia('(min-width: 1200px)').matches) {
                        return;
                    }

                    document.querySelectorAll('.bb-plp-img--desktop-eager').forEach(function (img) {
                        img.loading = 'eager';
                    });
                })();
            </script>
        </div>
        <?= $block->getChildBlock('toolbar')->setIsBottom(true)->toHtml() ?>
    </section>
<?php endif; ?>
