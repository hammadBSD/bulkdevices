<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */

$deferredStylesUrl = $block->getViewFileUrl('css/pdp-deferred.css');
$deferredStylesUrlEscaped = $escaper->escapeUrl($deferredStylesUrl);
$deferredStylesUrlJs = $escaper->escapeJs($deferredStylesUrl);
?>
<link rel="stylesheet"
      id="pdp-deferred-stylesheet"
      href="<?= $deferredStylesUrlEscaped ?>"
      media="print"
      onload="if (!window.matchMedia('(max-width: 1199px)').matches) { this.media = 'all'; }">
<noscript>
    <link rel="stylesheet" href="<?= $deferredStylesUrlEscaped ?>">
</noscript>
<script>
    (function () {
        if (!window.matchMedia('(max-width: 1199px)').matches) {
            return;
        }

        var link = document.getElementById('pdp-deferred-stylesheet');
        if (link) {
            link.remove();
        }

        function loadPdpDeferredStyles() {
            if (document.getElementById('pdp-deferred-stylesheet-loaded')) {
                return;
            }

            var deferred = document.createElement('link');
            deferred.id = 'pdp-deferred-stylesheet-loaded';
            deferred.rel = 'stylesheet';
            deferred.href = '<?= $deferredStylesUrlJs ?>';
            document.head.appendChild(deferred);
        }

        if (document.readyState === 'complete') {
            loadPdpDeferredStyles();
        } else {
            window.addEventListener('load', loadPdpDeferredStyles, { once: true });
        }
    })();
</script>
