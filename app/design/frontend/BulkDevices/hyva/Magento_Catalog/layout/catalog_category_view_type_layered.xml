<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Hyvä layered navigation instead of Mageplaza Luma / RequireJS templates -->
        <referenceBlock name="catalog.leftnav">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Magento_LayeredNavigation::layer/view.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="catalog.navigation.renderer">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Magento_LayeredNavigation::layer/filter.phtml</argument>
            </action>
        </referenceBlock>
    </body>
</page>
