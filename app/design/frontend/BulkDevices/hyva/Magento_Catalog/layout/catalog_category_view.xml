<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="css/plp-critical.css"/>
        <css src="css/product-card.css"/>
    </head>
    <body>
        <referenceBlock name="head.additional">
            <block name="plp.deferred.styles"
                   template="Magento_Catalog::category/plp-deferred-styles.phtml"
                   before="-"/>
            <block name="plp.product.preloads"
                   template="Magento_Catalog::category/head-preloads.phtml"
                   after="plp.deferred.styles"/>
        </referenceBlock>
        <referenceBlock name="bdus.hyva.quotation.modal" remove="true"/>
        <referenceBlock name="custom.block" remove="true"/>
        <referenceBlock name="getaquote_index_index" remove="true"/>

        <referenceBlock name="breadcrumbs">
            <arguments>
                <argument name="skip_ld_json_schema" xsi:type="boolean">true</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="category.products.list">
            <arguments>
                <argument name="eager_load_images_count" xsi:type="number">4</argument>
            </arguments>
            <block name="category.product.card"
                   as="product.card"
                   template="Magento_Theme::html/product/card.phtml"/>
        </referenceBlock>

        <referenceContainer name="page.bottom.container">
            <block class="Aalogics\CategoryText\Block\CategoryText"
                   name="category.text.bottom"
                   template="Magento_Catalog::category/bottom-text.phtml"/>
            <block class="Aalogics\CategoryText\Block\CategoryText"
                   name="category.faqs.bottom"
                   template="Magento_Catalog::category/faqs.phtml"
                   after="category.text.bottom"/>
        </referenceContainer>

        <referenceContainer name="before.body.end">
            <block name="plp.schema.jsonld"
                   template="BSD_Storefront::schema/json-ld.phtml"
                   before="-">
                <arguments>
                    <argument name="page_type" xsi:type="string">category</argument>
                </arguments>
            </block>
            <block name="product.card.qty.script"
                   template="Magento_Theme::html/product/card-qty-script.phtml"/>
            <block name="plp.ajax.layer"
                   template="Magento_Catalog::product/list/ajax-layer.phtml"
                   ifconfig="layered_navigation/general/ajax_enable"/>
        </referenceContainer>
    </body>
</page>
