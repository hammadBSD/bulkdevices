<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Keep Hyvä CustomCheckout success template; do not use legacy Porto/Luma RLTSquare template -->
        <referenceBlock name="checkout.success">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Hyva_CustomCheckout::success.phtml</argument>
            </action>
        </referenceBlock>
    </body>
</page>
