<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="hyva_quotation_modal"/>
    <head>
        <css src="css/home.css"/>
        <link src="https://bulkdevices.com/media/wysiwyg/banner-28-4-25-m.webp"
              src_type="url"
              rel="preload"
              as="image"
              fetchpriority="high"
              media="(max-width: 576px)"/>
        <link src="https://bulkdevices.com/media/wysiwyg/banner-28-4-25-d.webp"
              src_type="url"
              rel="preload"
              as="image"
              fetchpriority="high"
              media="(min-width: 577px)"/>
        <remove src="Mageplaza_Blog::css/mpBlogIcon.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block name="home-content"
                   template="Magento_Theme::html/home/content.phtml"
                   before="-">
                <block name="home-promotional-products"
                       as="home_promotional_products"
                       template="Magento_Theme::html/home/promotional-products.phtml">
                    <arguments>
                        <argument name="product_count" xsi:type="number">8</argument>
                    </arguments>
                    <block name="home-promotional-all-static"
                           as="promotional_all_static"
                           template="Magento_Theme::html/home/promotional-products-all-static.phtml">
                        <block name="home.promotional.product.card"
                               as="product.card"
                               template="Magento_Theme::html/product/card.phtml"/>
                    </block>
                </block>
                <block name="home-featured-products"
                       as="home_featured_products"
                       template="Magento_Theme::html/home/featured-products.phtml">
                    <arguments>
                        <argument name="category_id" xsi:type="number">253</argument>
                        <argument name="product_count" xsi:type="number">5</argument>
                        <argument name="title" xsi:type="string" translate="true">Featured Product</argument>
                    </arguments>
                    <block name="home.product.card"
                           as="product.card"
                           template="Magento_Theme::html/product/card.phtml"/>
                </block>
            </block>
        </referenceContainer>

        <referenceBlock name="hero" remove="true"/>
        <referenceBlock name="slider-1" remove="true"/>
        <referenceBlock name="slider-2" remove="true"/>
        <referenceBlock name="cms_page" remove="true"/>
        <referenceBlock name="page.main.title" remove="true"/>

        <referenceContainer name="before.body.end">
            <block name="product.card.qty.script"
                   template="Magento_Theme::html/product/card-qty-script.phtml"/>
        </referenceContainer>
    </body>
</page>
