<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="hyva_quotation_modal"/>
    <head>
        <css src="css/home-critical.css"/>
        <link src="https://www.shopperapproved.com"
              src_type="url"
              rel="preconnect"/>
        <link src="https://bulkdevices.com/media/wysiwyg/banner-28-4-25-m.webp"
              src_type="url"
              rel="preload"
              as="image"
              fetchpriority="high"
              media="(max-width: 576px)"/>
        <link src="https://bulkdevices.com/media/wysiwyg/banner-28-4-25-d.webp"
              src_type="url"
              rel="preload"
              as="image"
              fetchpriority="high"
              media="(min-width: 577px)"/>
        <remove src="Mageplaza_Blog::css/mpBlogIcon.css"/>
    </head>
    <body>
        <referenceBlock name="head.additional">
            <block name="home.deferred.styles"
                   template="Magento_Theme::html/home/deferred-styles.phtml"
                   before="-"/>
            <block name="home.promotional.preloads"
                   template="Magento_Theme::html/home/head-preloads.phtml"
                   after="home.deferred.styles"/>
        </referenceBlock>
        <referenceContainer name="content">
            <block name="home-content"
                   template="Magento_Theme::html/home/content.phtml"
                   before="-">
                <block name="home-promotional-products"
                       as="home_promotional_products"
                       template="Magento_Theme::html/home/promotional-products.phtml">
                    <arguments>
                        <argument name="product_count" xsi:type="number">10</argument>
                    </arguments>
                    <block name="home-promotional-all-static"
                           as="promotional_all_static"
                           template="Magento_Theme::html/home/promotional-products-all-static.phtml">
                        <block name="home.promotional.product.card"
                               as="product.card"
                               template="Magento_Theme::html/product/card.phtml"/>
                    </block>
                </block>
                <block name="home-top-categories"
                       as="home_top_categories"
                       template="Magento_Theme::html/home/top-categories.phtml"/>
                <block name="home-featured-blogs"
                       as="home_featured_blogs"
                       template="Magento_Theme::html/home/featured-blogs.phtml"/>
                <block name="home-customers-review"
                       as="home_customers_review"
                       template="Magento_Theme::html/home/customers-review.phtml"/>
            </block>
        </referenceContainer>

        <referenceBlock name="hero" remove="true"/>
        <referenceBlock name="slider-1" remove="true"/>
        <referenceBlock name="slider-2" remove="true"/>
        <referenceBlock name="cms_page" remove="true"/>
        <referenceBlock name="page.main.title" remove="true"/>

        <referenceBlock name="script-alpine-js">
            <block name="home.product.tabs.script"
                   template="Magento_Theme::html/home/product-tabs-script.phtml"
                   before="-"/>
        </referenceBlock>
    </body>
</page>
