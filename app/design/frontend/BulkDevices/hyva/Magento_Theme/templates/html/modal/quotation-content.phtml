<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
?>
<div id="quotation-modal-title" class="text-xl font-semibold tracking-wide uppercase mb-4">
    <?= $escaper->escapeHtml(__('Request For Quotation')) ?>
</div>

<div
    x-show="message"
    x-cloak
    class="mb-4 rounded px-3 py-2 text-sm"
    :class="messageType === 'success' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'"
    x-text="message"
    role="status"
    aria-live="polite"
></div>

<div x-show="productImage" x-cloak class="mb-4 flex items-center gap-4">
    <img
        :src="productImage"
        alt=""
        class="h-24 w-24 object-contain border border-gray-200 rounded"
        width="96"
        height="96"
    >
    <p x-show="sku" class="text-sm font-medium text-gray-700">
        <span class="text-gray-500"><?= $escaper->escapeHtml(__('SKU')) ?>:</span>
        <span x-text="sku"></span>
    </p>
</div>

<form @submit.prevent="submitQuotation()" novalidate>
    <div class="space-y-3">
        <div class="field">
            <label class="sr-only" for="quotation-name"><?= $escaper->escapeHtml(__('Name')) ?></label>
            <input
                id="quotation-name"
                type="text"
                name="name"
                class="form-input w-full"
                placeholder="<?= $escaper->escapeHtmlAttr(__('Name')) ?>"
                required
                x-model="name"
                :disabled="isSubmitting"
            >
        </div>
        <div class="field">
            <label class="sr-only" for="quotation-phone"><?= $escaper->escapeHtml(__('Telephone')) ?></label>
            <input
                id="quotation-phone"
                type="tel"
                name="phone"
                class="form-input w-full"
                placeholder="<?= $escaper->escapeHtmlAttr(__('Telephone')) ?>"
                required
                x-model="phone"
                :disabled="isSubmitting"
            >
        </div>
        <div class="field">
            <label class="sr-only" for="quotation-email"><?= $escaper->escapeHtml(__('Email')) ?></label>
            <input
                id="quotation-email"
                type="email"
                name="email"
                class="form-input w-full"
                placeholder="<?= $escaper->escapeHtmlAttr(__('Email')) ?>"
                required
                x-model="email"
                :disabled="isSubmitting"
            >
        </div>
    </div>

    <div class="mt-6 flex flex-wrap justify-end gap-2">
        <button type="button" class="btn" @click="cancel()" :disabled="isSubmitting">
            <?= $escaper->escapeHtml(__('Cancel')) ?>
        </button>
        <button type="submit" class="btn btn-primary" :disabled="isSubmitting">
            <span x-show="!isSubmitting"><?= $escaper->escapeHtml(__('Send')) ?></span>
            <span x-show="isSubmitting" x-cloak><?= $escaper->escapeHtml(__('Sending…')) ?></span>
        </button>
    </div>
</form>
