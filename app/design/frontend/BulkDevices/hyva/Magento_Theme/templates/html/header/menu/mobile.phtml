<?php
/**
 * Mobile menu shell — panel HTML loads on first open via AJAX to keep homepage payload small.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);

$menuUrl = $block->getUrl('bsd/menu/mobile');
?>
<div x-data="initMobileMenu" x-bind="eventListeners" class="lg:hidden mobile-menu">
    <button
        type="button"
        class="btn bg-transparent border-transparent p-2"
        aria-label="<?= $escaper->escapeHtmlAttr(__('Open menu')) ?>"
        @click="loadAndOpen"
        :aria-busy="loading"
    >
        <?= $lucideIcons->menuHtml('', 24, 24, ['aria-hidden' => 'true']) ?>
    </button>
    <div x-ref="menuRoot" class="contents"></div>
</div>
<script>
    const initMobileMenu = () => {
        return {
            menuUrl: '<?= $escaper->escapeJs($menuUrl) ?>',
            loading: false,
            isOpen: false,
            isSubMenuOpen: false,
            init() {},
            loadAndOpen() {
                if (this.loading) {
                    return;
                }
                const root = this.$refs.menuRoot;
                if (root.childElementCount > 0) {
                    this.markCurrentPageLinks();
                    this.open();
                    return;
                }
                this.loading = true;
                fetch(this.menuUrl, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin'
                })
                    .then((response) => {
                        if (!response.ok) {
                            throw new Error('Failed to load menu');
                        }
                        return response.text();
                    })
                    .then((html) => {
                        root.innerHTML = html;
                        if (typeof Alpine !== 'undefined' && typeof Alpine.initTree === 'function') {
                            Alpine.initTree(root);
                        }
                        this.markCurrentPageLinks();
                        this.open();
                    })
                    .catch(() => {
                        window.location.href = '<?= $escaper->escapeJs($block->getUrl('catalogsearch/result')) ?>';
                    })
                    .finally(() => {
                        this.loading = false;
                    });
            },
            markCurrentPageLinks() {
                Array.from(this.$root.querySelectorAll('a')).forEach((link) => {
                    if (link.href === `${window.location.origin}${window.location.pathname}`) {
                        link.setAttribute('aria-current', 'page');
                    }
                });
            },
            open() {
                this.isOpen = true;
            },
            close() {
                this.isOpen = false;
            },
            lockWrapperScroll() {
                return this.isSubMenuOpen ? { overflow: 'hidden' } : {};
            },
            hasActiveSubMenu() {
                this.isSubMenuOpen = !!this.$root.querySelector('[data-open]');
            },
            eventListeners: {
                ['@pageshow.window'](event) {
                    if (event.persisted) {
                        this.close();
                    }
                },
                ['@sub-menu-state-change.window']() {
                    this.hasActiveSubMenu();
                }
            }
        };
    };

    const initMobileSubMenu = () => {
        return {
            isOpen: false,
            open() {
                this.isOpen = true;
                this.$root.setAttribute('data-open', '');
                this.$nextTick(() => {
                    this.$dispatch('sub-menu-state-change');
                    this.$refs.closeSubMenuBtn.focus();
                    this.toggleInert();
                });
            },
            close() {
                this.isOpen = false;
                this.$root.removeAttribute('data-open');
                this.toggleInert();
                this.$nextTick(() => {
                    this.$dispatch('sub-menu-state-change');
                    this.$refs.openSubMenuBtn.focus();
                });
            },
            toggleInert() {
                const parent = this.$root.parentElement;
                if (!parent) {
                    return;
                }

                for (const item of parent.children) {
                    if (item === this.$root) {
                        continue;
                    }
                    item.classList.toggle('mobile-menu-branch--hidden', this.isOpen);
                    item.toggleAttribute('inert', this.isOpen);
                }
            }
        };
    };

    document.addEventListener('alpine:init', () => {
        Alpine.data('initMobileMenu', initMobileMenu);
        Alpine.data('initMobileSubMenu', initMobileSubMenu);
    }, { once: true });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
