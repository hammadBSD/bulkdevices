<?php

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\ProductPage;
use Hyva\Theme\ViewModel\ProductPrice;
use Magento\Catalog\Model\Product;
use Magento\Catalog\Pricing\Price\FinalPrice;
use Magento\Framework\Escaper;
use Magento\Framework\Pricing\Helper\Data as PricingHelper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var Product|null $product */
$product = $block->getData('product');
if (!$product instanceof Product) {
    return;
}

/** @var ProductPage $productViewModel */
$productViewModel = $viewModels->require(ProductPage::class);

/** @var ProductPrice $productPriceViewModel */
$productPriceViewModel = $viewModels->require(ProductPrice::class);

/** @var PricingHelper $pricingHelper */
$pricingHelper = $this->helper(PricingHelper::class);

$productUrl = parse_url($product->getProductUrl(), PHP_URL_PATH) ?: $product->getProductUrl();
$productName = (string) $product->getName();
$sku = (string) $product->getSku();
$productType = $product->getTypeId();
$finalPrice = (float) $productPriceViewModel->getPriceValue(FinalPrice::PRICE_CODE, $product);
$isCallForPrice = $finalPrice <= 0;
$showFromLabel = !$isCallForPrice && in_array($productType, ['configurable', 'bundle', 'grouped'], true);
$formattedPrice = $pricingHelper->currency($product->getFinalPrice(), true, false);
$imageCustomAttributes = $product->getData('image_custom_attributes') ?? [];
$imageLoading = (string) ($imageCustomAttributes['loading'] ?? 'lazy');
$imageFetchPriority = isset($imageCustomAttributes['fetchpriority'])
    ? (string) $imageCustomAttributes['fetchpriority']
    : null;
$imageExtraClass = (string) ($imageCustomAttributes['class'] ?? '');
$imageClass = 'bb-product-card__img home-product-tabs__img'
    . ($imageExtraClass !== '' ? ' ' . $imageExtraClass : '');
$viewMode = (string) ($block->getData('view_mode') ?? 'grid');
$isListView = $viewMode === 'list';
$cardClass = 'bb-product-card home-product-tabs__card' . ($isListView ? ' bb-product-card--list' : '');
$imageRole = $isListView ? 'category_page_list' : 'category_page_grid';
$image = $productViewModel->getImage($product, $imageRole);
$imageUrl = $image->getImageUrl();
$imageLabel = $image->getLabel() ?: $productName;
?>

<article class="<?= $escaper->escapeHtmlAttr($cardClass) ?>">
    <a class="bb-product-card__media home-product-tabs__media" href="<?= $escaper->escapeUrl($productUrl) ?>">
        <img class="<?= $escaper->escapeHtmlAttr($imageClass) ?>"
             src="<?= $escaper->escapeUrl($imageUrl) ?>"
             width="250"
             height="250"
             <?php if (!$isListView): ?>
             sizes="(min-width: 1280px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
             <?php endif; ?>
             alt="<?= $escaper->escapeHtmlAttr($imageLabel) ?>"
             loading="<?= $escaper->escapeHtmlAttr($imageLoading) ?>"
             <?php if ($imageFetchPriority): ?>
             fetchpriority="<?= $escaper->escapeHtmlAttr($imageFetchPriority) ?>"
             <?php endif; ?>
             decoding="async">
    </a>
    <div class="bb-product-card__body home-product-tabs__body">
        <h3 class="bb-product-card__name home-product-tabs__name">
            <a href="<?= $escaper->escapeUrl($productUrl) ?>"><?= $escaper->escapeHtml($sku) ?></a>
        </h3>
        <p class="bb-product-card__desc home-product-tabs__desc"><?= $escaper->escapeHtml($productName) ?></p>
        <?php if (!$isCallForPrice): ?>
            <p class="bb-product-card__price home-product-tabs__price">
                <?php if ($showFromLabel): ?>
                    <span class="bb-product-card__price-label home-product-tabs__price-label"><?= $escaper->escapeHtml(__('From')) ?></span>
                <?php endif; ?>
                <?= $escaper->escapeHtml($formattedPrice) ?>
            </p>
        <?php endif; ?>
        <?php if ($isCallForPrice): ?>
            <a
                class="bb-product-card__cta home-product-tabs__cta"
                href="<?= $escaper->escapeUrl($productUrl) ?>"
                aria-label="<?= $escaper->escapeHtmlAttr(__('Request For Quotation %1', $sku)) ?>"
            >
                <?= $escaper->escapeHtml(__('Request For Quotation')) ?>
            </a>
        <?php elseif ($product->isSaleable()): ?>
            <a
                class="bb-product-card__cta home-product-tabs__cta"
                href="<?= $escaper->escapeUrl($productUrl) ?>"
                aria-label="<?= $escaper->escapeHtmlAttr(__('Add to Cart %1', $sku)) ?>"
            >
                <?= $escaper->escapeHtml(__('Add to Cart')) ?>
            </a>
        <?php endif; ?>
    </div>
</article>
