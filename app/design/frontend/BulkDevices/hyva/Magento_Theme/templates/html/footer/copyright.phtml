<?php
/**
 * BulkDevices footer copyright
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Theme\Block\Html\Footer;

/** @var Footer $block */
/** @var Escaper $escaper */

$copyright = trim((string) $block->getCopyright());
?>
<p class="site-footer__copyright">
    <?php if ($copyright !== ''): ?>
        <?= $escaper->escapeHtml($copyright) ?>
    <?php else: ?>
        <?= $escaper->escapeHtml(__('© %1 BulkDevices. All rights reserved.', date('Y'))) ?>
    <?php endif; ?>
</p>
