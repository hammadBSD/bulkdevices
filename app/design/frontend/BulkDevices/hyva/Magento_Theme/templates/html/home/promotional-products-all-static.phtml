<?php

declare(strict_types=1);

use BSD\Storefront\ViewModel\PromotionalProducts;
use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\ProductList;
use Magento\Catalog\Model\Product;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var PromotionalProducts $promotionalProducts */
$promotionalProducts = $viewModels->require(PromotionalProducts::class);

/** @var ProductList $productListViewModel */
$productListViewModel = $viewModels->require(ProductList::class);

$urlKeys = $promotionalProducts->getStaticHardDriveUrlKeys();

$productListViewModel->addFilter('url_key', $urlKeys, 'in');
$productListViewModel->setPageSize(count($urlKeys));

$productsByUrlKey = [];
foreach ($productListViewModel->getItems() as $product) {
    if ($product instanceof Product) {
        $productsByUrlKey[(string) $product->getUrlKey()] = $product;
    }
}

$cardBlock = $block->getChildBlock('product.card');
?>

<ul class="home-product-tabs__grid">
    <?php foreach ($urlKeys as $index => $urlKey): ?>
        <?php
        $product = $productsByUrlKey[$urlKey] ?? null;
        if (!$product instanceof Product) {
            continue;
        }
        $product->setData('image_custom_attributes', $promotionalProducts->getFeaturedCardImageAttributes($index));
        ?>
        <li class="bb-product-grid__item home-product-tabs__item">
            <?= $cardBlock
                ?->setData('product', $product)
                ->setData('hide_qty_selector', true)
                ->toHtml() ?>
        </li>
    <?php endforeach; ?>
</ul>
