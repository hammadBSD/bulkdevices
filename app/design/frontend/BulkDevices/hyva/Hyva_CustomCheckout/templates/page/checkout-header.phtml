<?php
declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\Logo\LogoPathResolver;
use Hyva\Theme\ViewModel\LucideIcons;
use Hyva\Theme\ViewModel\StoreConfig;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magento\Store\Model\Information as StoreInformation;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$logoPathResolver = $viewModels->require(LogoPathResolver::class);
$storeConfig = $viewModels->require(StoreConfig::class);
$lucideIcons = $viewModels->require(LucideIcons::class);
$storePhone = $storeConfig->getStoreConfig(StoreInformation::XML_PATH_STORE_INFO_PHONE) ?: '(903) 677-4333';
$logoSrc = $logoPathResolver->getLogoSrc();
$storePhoneDigits = preg_replace('/\D+/', '', $storePhone) ?: '';
?>
<header class="hcc-header">
    <div class="hcc-header__inner">
        <a href="<?= $escaper->escapeUrl($block->getUrl('')) ?>" class="hcc-header__logo" title="<?= $escaper->escapeHtmlAttr(__('Home')) ?>">
            <img src="<?= $escaper->escapeUrl($logoSrc) ?>"
                 alt="<?= $escaper->escapeHtmlAttr($block->getLogoAlt() ?: 'BulkDevices') ?>"
                 width="189"
                 height="64"
                 loading="eager"
                 decoding="async"/>
        </a>
        <div class="hcc-header__actions">
            <a href="tel:<?= $escaper->escapeUrl($storePhoneDigits) ?>"
               class="hcc-header__phone">
                <span class="hcc-header__phone-icon" aria-hidden="true">
                    <?= $lucideIcons->phoneHtml('', 32, 32) ?>
                </span>
                <span class="hcc-header__phone-text">
                    <span class="hcc-header__phone-label"><?= $escaper->escapeHtml(__('Call Us at')) ?></span>
                    <span class="hcc-header__phone-number"><?= $escaper->escapeHtml($storePhone) ?></span>
                </span>
            </a>
            <?php if (!$block->getData('hide_sign_in')): ?>
                <a href="<?= $escaper->escapeUrl($block->getUrl('customer/account/login', ['referer' => base64_encode($block->getUrl('*/*/*', ['_current' => true, '_use_rewrite' => true]))])) ?>"
                   class="hcc-header__signin">
                    <?= $escaper->escapeHtml(__('Sign In')) ?>
                </a>
            <?php endif; ?>
        </div>
    </div>
</header>
