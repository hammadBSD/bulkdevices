<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="catalogsearch.leftnav">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Magento_LayeredNavigation::layer/view.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="catalogsearch.navigation.renderer"
                        class="BSD\Storefront\Block\Navigation\FilterRenderer"
                        template="Magento_LayeredNavigation::layer/filter.phtml">
            <arguments>
                <argument name="plp_layer_filter" xsi:type="object">BSD\Storefront\ViewModel\PlpLayerFilter</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
