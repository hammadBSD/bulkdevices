        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        text-align: center;
    }

    .bdus-rfq-thankyou__title {
        margin: 0 0 1rem;
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 700;
        color: #111827;
    }

    .bdus-rfq-thankyou__lead {
        margin: 0 0 1rem;
        font-size: 1rem;
        line-height: 1.7;
        color: #4b5563;
    }

    .bdus-rfq-thankyou__meta {
        margin: 0 0 1.5rem;
        font-size: 0.9375rem;
