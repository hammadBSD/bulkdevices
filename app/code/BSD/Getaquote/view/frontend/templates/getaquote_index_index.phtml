<div id="popup-modal"
     class="bd-quote-modal-source call-for-price-modal-popup-category"
     style="display:none;"
     aria-hidden="true">
    <div class="bd-quote-modal">
        <div class="bd-quote-modal__media">
            <img src="" alt="" class="bd-quote-modal__img product_image" width="280" height="280"/>
            <input type="hidden" name="sku" value=""/>
        </div>
        <div class="bd-quote-modal__body">
            <form name="call_for_price_listing"
                  method="post"
                  id="call_for_price_listing"
                  class="bd-quote-modal__form"
                  action="<?= $block->escapeUrl($block->getFormAction()) ?>"
                  data-hasrequired="<?= $block->escapeHtmlAttr(__('* Required Fields')) ?>"
                  data-mage-init='{"validation":{}}'>
                <p class="bd-quote-modal__message responce_message_call_price_listing"></p>
                <h2 id="bd-quote-modal-title" class="bd-quote-modal__title"><?= $block->escapeHtml(__('Request For Free Quotation')) ?></h2>
                <div class="bd-quote-modal__fields">
                    <input class="bd-quote-modal__input"
                           placeholder="<?= $block->escapeHtmlAttr(__('Name')) ?>"
                           name="name"
                           id="name"
                           title="<?= $block->escapeHtmlAttr(__('Name')) ?>"
                           type="text"
                           data-validate="{required:true, 'validate-alphanum-with-spaces':true}"/>
                    <input class="bd-quote-modal__input"
                           placeholder="<?= $block->escapeHtmlAttr(__('Telephone')) ?>"
                           name="telephone"
                           id="telephone"
                           title="<?= $block->escapeHtmlAttr(__('Telephone')) ?>"
                           type="text"
                           data-validate="{required:true}"/>
                    <input class="bd-quote-modal__input"
                           placeholder="<?= $block->escapeHtmlAttr(__('Email')) ?>"
                           name="email"
                           id="email"
                           title="<?= $block->escapeHtmlAttr(__('Email')) ?>"
                           type="email"
                           data-validate="{required:true, 'validate-email':true}"/>
                </div>
                <button type="submit"
                        class="bd-quote-modal__submit submit_call_for_price_listing"
                        title="<?= $block->escapeHtmlAttr(__('Send')) ?>">
                    <?= $block->escapeHtml(__('Send')) ?>
                </button>
            </form>
        </div>
    </div>
</div>


<script>
require([
    'jquery',
    'Magento_Ui/js/modal/modal'
], function ($, modal) {
    'use strict';

    var $popup = $('#popup-modal');
    if (!$popup.length) {
        return;
    }

    var quoteModalLabel = <?= json_encode((string) __('Request For Free Quotation'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
    var quoteModalCloseLabel = <?= json_encode((string) __('Close'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;

    var options = {
        type: 'popup',
        responsive: true,
        innerScroll: true,
        buttons: [],
        modalClass: 'call-for-price-modal-plp-popup',
        closeText: quoteModalCloseLabel
    };

    function setQuoteDialogAccessibleName() {
        var $dialog = $popup.closest('[role="dialog"]');
        if (!$dialog.length) {
            $dialog = $('.call-for-price-modal-plp-popup[role="dialog"]').last();
        }
        if ($dialog.length) {
            $dialog.attr({
                'aria-labelledby': 'bd-quote-modal-title',
                'aria-label': quoteModalLabel
            });
            $dialog.find('.action-close').attr('aria-label', quoteModalCloseLabel);
        }
    }

    modal(options, $popup);
    setQuoteDialogAccessibleName();

    var baseUrl = window.location.origin || '';

    function openQuoteModal(sku) {
        $('input[name=sku]', $popup).val(sku || '');
        $('.bd-quote-modal__img', $popup).attr('alt', sku || '');
        if (sku) {
            $.ajax({
                type: 'POST',
                showLoader: true,
                url: baseUrl + '/getaquote/index/getimagepath',
                data: { product_sku: sku },
                dataType: 'json'
            }).done(function (response) {
                if (response && response.json_data) {
                    $('.product_image', $popup).attr('src', response.json_data);
                }
            });
        }
        $popup.modal('openModal');
        setQuoteDialogAccessibleName();
    }

    $(document).on('click', '.calltoprice', function (event) {
        event.preventDefault();
        openQuoteModal($(this).data('sku'));
    });

    $popup.on('click', '.submit_call_for_price_listing', function (event) {
        event.preventDefault();
        var $form = $('#call_for_price_listing', $popup);
        $.ajax({
            showLoader: true,
            url: baseUrl + '/getaquote/Index/formpost/',
            data: $form.serialize(),
            type: 'POST'
        }).done(function (data) {
            $('.responce_message_call_price_listing', $popup).html(data).css('color', 'red');
            $form[0].reset();
            setTimeout(function () {
                $('.responce_message_call_price_listing', $popup).empty();
                $popup.modal('closeModal');
            }, 3000);
        });
    });
});
</script>
