            function ($, modal) {
                var options = {
                    type: 'popup',
                    responsive: true,
                    innerScroll: true,
                    buttons: [],
                    modalClass: "call-for-price-modal-pdp-popup"
                };

                // var popup = modal(options, $('#popup-modal'));
