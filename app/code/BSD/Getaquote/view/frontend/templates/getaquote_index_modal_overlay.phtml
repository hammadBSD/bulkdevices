    <script type="text/javascript">
        require([
            "jquery",
            "jquery/ui"
        ], function ($v) {
//<![CDATA[
            $v = jQuery.noConflict();
            $v(document).ready(function () {
                var dataForm = $v('#call_for_price');
                var base_url = window.location.origin;
                var AjaxUrl = base_url + '/getaquote/Index/formpost/';
                //var AjaxUrl = '<?php //echo 'https://www.gracileit.com/getaquote/Index/formpost'?>//';
                console.log('jquery loaded from emq.js');
                $v(".submit_call_for_price").on('click', function (e) {
                    var param = dataForm.serialize();
                    console.log(param);
                    $v.ajax({
                        showLoader: true,
                        url: AjaxUrl,
                        data: param,
                        type: "POST"
                    }).done(function (data) {
                        $v('.responce_message_call_price').html(data);
                        $v('.responce_message_call_price').css('color', 'red');
                        document.getElementById("call_for_price").reset();
                        setTimeout(function(){
                            $v('.responce_message_call_price').empty();
                            $v("#callforprice").modal("closeModal");
                        }, 3000);


                    });
                    return false;
                });
                $v('.product-info-main').find('.pdp-getquote').closest('.product-info-price').addClass('getquote-active');
            });
//]]>
        });
    </script>
