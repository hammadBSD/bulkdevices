<?php
/** @var \BSD\Theme\Block\Product\View $block */
/** @var \BSD\ExpertSupportTeamTab\ViewModel\ExpertSupportTabViewModel|null $viewModel */
$viewModel = $block->getData('view_model');
$productSku = $viewModel ? $viewModel->getProductSku() : $block->getPartNumber();
$formAction = $block->getUrl('getaquote/index', ['_secure' => true]);
$whatsapp = $viewModel ? $viewModel->getWhatsappPhoneNumber() : '';
$whatsappMsg = $viewModel ? rawurlencode((string) $viewModel->getWhatsappMessage()) : '';
$whatsappHref = $whatsapp !== ''
    ? 'https://wa.me/' . preg_replace('/\D+/', '', $whatsapp) . ($whatsappMsg !== '' ? '?text=' . $whatsappMsg : '')
    : '#';
$storeEmail = $block->getStoreEmail();
?>
<aside class="bd-pdp-expert" aria-labelledby="bd-pdp-expert-title">
    <div class="bd-pdp-expert__avatar" aria-hidden="true">
        <img class="bd-pdp-expert__avatar-img"
             src="<?= $block->escapeUrl($block->getPdpIconUrl('expert-support.webp')) ?>"
             alt=""
             width="72"
             height="72"
             loading="lazy"
             decoding="async"/>
        <span class="bd-pdp-expert__status"></span>
    </div>
    <h2 class="bd-pdp-expert__title" id="bd-pdp-expert-title"><?= $block->escapeHtml(__('Expert Team Support')) ?></h2>
    <p class="bd-pdp-expert__links">
        <a href="#" class="bd-pdp-expert__link" data-action="chat"><?= $block->escapeHtml(__('Chat')) ?></a>
        <span aria-hidden="true">|</span>
        <a href="<?= $block->escapeUrl($whatsappHref) ?>" class="bd-pdp-expert__link" target="_blank" rel="noopener noreferrer"><?= $block->escapeHtml(__('Whatsapp')) ?></a>
        <span aria-hidden="true">|</span>
        <?php if ($storeEmail !== ''): ?>
            <a href="mailto:<?= $block->escapeHtmlAttr($storeEmail) ?>" class="bd-pdp-expert__link"><?= $block->escapeHtml(__('Email')) ?></a>
        <?php else: ?>
            <span class="bd-pdp-expert__link"><?= $block->escapeHtml(__('Email')) ?></span>
        <?php endif; ?>
    </p>
    <p class="bd-pdp-expert__hint"><?= $block->escapeHtml(__('Looking for a quote for special price or bulk quantity')) ?></p>

    <form class="bd-pdp-expert__form"
          name="bdExpertSupport"
          id="bd-expert-support-form"
          method="post"
          action="<?= $block->escapeUrl($formAction) ?>">
        <div class="bd-pdp-expert__field">
            <input type="text"
                   name="name"
                   id="bd-expert-name"
                   class="input-text"
                   placeholder="<?= $block->escapeHtmlAttr(__('Full Name')) ?>"
                   data-validate="{required:true}"/>
        </div>
        <div class="bd-pdp-expert__field">
            <input type="email"
                   name="email"
                   id="bd-expert-email"
                   class="input-text"
                   placeholder="<?= $block->escapeHtmlAttr(__('Email Address')) ?>"
                   data-validate="{required:true, 'validate-email':true}"/>
        </div>
        <div class="bd-pdp-expert__field">
            <input type="tel"
                   name="phone"
                   id="bd-expert-phone"
                   class="input-text"
                   placeholder="<?= $block->escapeHtmlAttr(__('Phone Number')) ?>"
                   data-validate="{required:true}"/>
        </div>
        <input type="hidden" name="sku" value="<?= $block->escapeHtmlAttr($productSku) ?>"/>
        <input type="hidden" name="request_type" value="Expert Team Request"/>
        <input type="hidden" name="hideit" value=""/>
        <p class="bd-pdp-expert__message" role="status" aria-live="polite"></p>
        <button type="submit" class="bd-pdp-expert__submit action primary">
            <span><?= $block->escapeHtml(__('Submit Your Request')) ?></span>
        </button>
    </form>
</aside>
<script>
require(['jquery'], function ($) {
    var $form = $('#bd-expert-support-form');
    if (!$form.length) {
        return;
    }
    var validationReady = false;
    function ensureValidation(callback) {
        if (validationReady) {
            callback();
            return;
        }
        require(['mage/validation'], function () {
            $form.mage('validation', {});
            validationReady = true;
            callback();
        });
    }
    $form.find('input').one('focus', function () {
        ensureValidation(function () {});
    });
    $form.on('submit', function (e) {
        e.preventDefault();
        ensureValidation(function () {
            if (!$form.validation('isValid')) {
                return;
            }
            submitForm();
        });
        return false;
    });
    function submitForm() {
        $.ajax({
            showLoader: true,
            url: $form.attr('action'),
            data: $form.serialize(),
            type: 'POST'
        }).done(function (data) {
            $form.find('.bd-pdp-expert__message').text($.trim(data));
            $form[0].reset();
        }).fail(function () {
            $form.find('.bd-pdp-expert__message').text('<?= $block->escapeJs(__('We can\'t process your request right now. Sorry, that\'s all we know.')) ?>');
        });
    }
});
</script>
