<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="columns.top">
            <container name="bd.category.intro" htmlTag="div" htmlClass="bd-category-intro" before="-"/>
        </referenceContainer>
        <referenceContainer name="bd.category.intro">
            <block class="Magento\Theme\Block\Html\Breadcrumbs" name="breadcrumbs"/>
            <block class="Magento\Catalog\Block\Category\View" name="bd.category.header"
                   template="BSD_Theme::category/header.phtml"/>
        </referenceContainer>
        <referenceContainer name="sidebar.main">
            <block class="Magento\LayeredNavigation\Block\Navigation\Category"
                   name="catalog.leftnav"
                   template="BSD_Theme::category/layered.phtml"
                   before="-"/>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="Magento\Catalog\Block\Category\View"
                   name="bd.category.seo"
                   template="BSD_Theme::category/seo.phtml"
                   after="category.products"/>
        </referenceContainer>
    </body>
</page>
