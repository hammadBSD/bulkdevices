<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <block class="BSD\Theme\Block\Home\Sections"
               name="bd.homepage.preload"
               template="BSD_Theme::html/homepage-preload.phtml"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="BSD\Theme\Block\Home\Sections"
                   name="bd.homepage"
                   template="BSD_Theme::home/sections.phtml"
                   before="-">
                <block class="BSD\Theme\Block\Home\Sections"
                       name="bd.home.contact.form"
                       template="BSD_Theme::home/contact-form.phtml"/>
                <block class="BSD\Theme\Block\Home\Sections"
                       name="bd.home.seo.content"
                       template="BSD_Theme::home/seo-content.phtml"/>
            </block>
        </referenceContainer>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="cms_page" remove="true"/>
    </body>
</page>
