<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <fieldset name="display_settings">
        <field name="plp_filter_attributes" sortOrder="120" formElement="multiselect">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">category</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">PLP Attribute Filters</label>
                <notice translate="true">Choose which storage specification filters appear on this category. Manufacturer is managed separately and is not affected.</notice>
                <dataScope>plp_filter_attributes</dataScope>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="BSD\ProductAttributes\Model\Config\Source\ProductFilterAttributes"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="pdp_related_products_filter_attributes" sortOrder="130" formElement="multiselect">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">category</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">PDP Related Products Attribute Filters</label>
                <notice translate="true">Choose which attributes are used to match related products on the product page. Only products with the same values for all selected attributes are shown.</notice>
                <dataScope>pdp_related_products_filter_attributes</dataScope>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="BSD\ProductAttributes\Model\Config\Source\ProductFilterAttributes"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
    </fieldset>
</form>
