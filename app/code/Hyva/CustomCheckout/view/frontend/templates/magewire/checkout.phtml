<?php
declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var \Hyva\CustomCheckout\Magewire\Checkout $magewire */

$stripeConfigJson = $escaper->escapeHtmlAttr(json_encode($magewire->stripeConfig ?: [], JSON_THROW_ON_ERROR));
$elementOptions = $escaper->escapeHtmlAttr(json_encode($magewire->stripeElementOptions ?: [], JSON_THROW_ON_ERROR));
?>
<div class="hcc-checkout"
     wire:loading.class="hcc-is-loading"
     wire:init="refreshShippingRatesIfNeeded"
     x-data="initHccCheckoutStripe"
     data-stripe-config="<?= $stripeConfigJson ?>"
     data-element-options="<?= $elementOptions ?>"
     data-stripe-amount="<?= (int) ($magewire->totals['stripe_amount'] ?? 0) ?>"
     data-stripe-currency="<?= $escaper->escapeHtmlAttr($magewire->totals['stripe_currency'] ?? 'usd') ?>"
     data-default-country="<?= $escaper->escapeHtmlAttr($magewire->countryId ?: 'US') ?>"
     data-stripe-action-url="<?= $escaper->escapeHtmlAttr($block->getUrl('rest/V1/stripe/payments/get_requires_action')) ?>"
     data-success-url="<?= $escaper->escapeHtmlAttr($block->getUrl('checkout/onepage/success')) ?>"
     data-msg-unavailable="<?= $escaper->escapeHtmlAttr(__('Payment system is unavailable. Please try again later.')) ?>"
     data-msg-failed="<?= $escaper->escapeHtmlAttr(__('Payment failed. Please try again.')) ?>"
     @checkout-cart-updated.window="refreshElements"
     @checkout-payment-method-changed.window="onPaymentMethodChanged"
     @order-placed.window="handleAuthentication"
     @order-place-failed.window="onPlaceFailed">
    <?php if ($magewire->errorMessage): ?>
        <div class="hcc-error" role="alert"><?= $escaper->escapeHtml($magewire->errorMessage) ?></div>
    <?php endif; ?>

    <div class="hcc-grid">
        <!-- Column 1: Shipping Address -->
        <section class="hcc-card" aria-labelledby="hcc-shipping-title">
            <h2 id="hcc-shipping-title" class="hcc-card__title"><?= $escaper->escapeHtml(__('Shipping Address')) ?></h2>

            <?php if (!$magewire->isLoggedIn): ?>
                <div class="hcc-field">
                    <label for="hcc-email"><?= $escaper->escapeHtml(__('Email Address')) ?> <span class="req">*</span></label>
                    <input id="hcc-email" type="email" wire:model.blur="email" autocomplete="email" required/>
                </div>
                <label class="hcc-checkbox">
                    <input type="checkbox" wire:model.change="createAccount"/>
                    <span><?= $escaper->escapeHtml(__('Create New Account')) ?></span>
                </label>
                <?php if ($magewire->createAccount): ?>
                    <div class="hcc-field">
                        <label for="hcc-password"><?= $escaper->escapeHtml(__('Password')) ?> <span class="req">*</span></label>
                        <input id="hcc-password" type="password" wire:model.blur="password" autocomplete="new-password"/>
                    </div>
                    <div class="hcc-field">
                        <label for="hcc-password-confirm"><?= $escaper->escapeHtml(__('Confirm Password')) ?> <span class="req">*</span></label>
                        <input id="hcc-password-confirm" type="password" wire:model.blur="passwordConfirm" autocomplete="new-password"/>
                    </div>
                <?php endif; ?>
            <?php endif; ?>

            <div class="hcc-field-row">
                <div class="hcc-field">
                    <label for="hcc-firstname"><?= $escaper->escapeHtml(__('First Name')) ?> <span class="req">*</span></label>
                    <input id="hcc-firstname" type="text" wire:model.blur="firstname" autocomplete="given-name" required/>
                </div>
                <div class="hcc-field">
                    <label for="hcc-lastname"><?= $escaper->escapeHtml(__('Last Name')) ?> <span class="req">*</span></label>
                    <input id="hcc-lastname" type="text" wire:model.blur="lastname" autocomplete="family-name" required/>
                </div>
            </div>

            <div class="hcc-field">
                <label for="hcc-telephone"><?= $escaper->escapeHtml(__('Phone Number')) ?> <span class="req">*</span></label>
                <input id="hcc-telephone" type="tel" wire:model.blur="telephone" autocomplete="tel" required/>
            </div>

            <div class="hcc-field">
                <label for="hcc-street"><?= $escaper->escapeHtml(__('Street Address')) ?> <span class="req">*</span></label>
                <input id="hcc-street" type="text" wire:model.blur="street" autocomplete="address-line1" required/>
            </div>

            <div class="hcc-field">
                <label for="hcc-city"><?= $escaper->escapeHtml(__('City')) ?> <span class="req">*</span></label>
                <input id="hcc-city" type="text" wire:model.blur="city" autocomplete="address-level2" required/>
            </div>

            <div class="hcc-field-row">
                <div class="hcc-field">
                    <label for="hcc-region"><?= $escaper->escapeHtml(__('State/Province')) ?> <span class="req">*</span></label>
                    <select id="hcc-region" wire:model.change="regionId" autocomplete="address-level1">
                        <option value=""><?= $escaper->escapeHtml(__('Please select')) ?></option>
                        <?php foreach ($magewire->regions as $region): ?>
                            <option value="<?= $escaper->escapeHtmlAttr($region['id']) ?>"
                                <?= (string) $magewire->regionId === (string) $region['id'] ? 'selected' : '' ?>>
                                <?= $escaper->escapeHtml($region['name']) ?>
                            </option>
                        <?php endforeach; ?>
                    </select>
                </div>
                <div class="hcc-field">
                    <label for="hcc-postcode"><?= $escaper->escapeHtml(__('Zip/Postal Code')) ?> <span class="req">*</span></label>
                    <input id="hcc-postcode" type="text" wire:model.blur="postcode" autocomplete="postal-code" required/>
                </div>
            </div>

            <div class="hcc-field">
                <label for="hcc-country"><?= $escaper->escapeHtml(__('Country')) ?> <span class="req">*</span></label>
                <select id="hcc-country" wire:model.change="countryId" autocomplete="country">
                    <?php foreach ($magewire->countries as $country): ?>
                        <option value="<?= $escaper->escapeHtmlAttr($country['value']) ?>"
                            <?= $magewire->countryId === $country['value'] ? 'selected' : '' ?>>
                            <?= $escaper->escapeHtml($country['label']) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>

            <div class="hcc-field">
                <label for="hcc-company"><?= $escaper->escapeHtml(__('Company')) ?></label>
                <input id="hcc-company" type="text" wire:model.blur="company" autocomplete="organization"/>
            </div>
        </section>

        <!-- Column 2: Shipping + Payment -->
        <div>
            <section class="hcc-card<?= $magewire->isRefreshingShippingRates ? ' hcc-shipping-rates--refreshing' : '' ?>"
                     aria-labelledby="hcc-shipping-methods-title"
                     aria-busy="<?= $magewire->isRefreshingShippingRates ? 'true' : 'false' ?>">
                <h2 id="hcc-shipping-methods-title" class="hcc-card__title"><?= $escaper->escapeHtml(__('Shipping Methods')) ?></h2>
                <?php if ($magewire->isRefreshingShippingRates && $magewire->shippingMethods !== []): ?>
                    <p class="hcc-shipping-rates__status" role="status">
                        <?= $escaper->escapeHtml(__('Updating shipping rates…')) ?>
                    </p>
                <?php endif; ?>
                <?php if ($magewire->shippingMethods === []): ?>
                    <?php if ($magewire->isRefreshingShippingRates || $magewire->pendingShippingRatesRefresh): ?>
                        <p class="hcc-muted" role="status"><?= $escaper->escapeHtml(__('Loading shipping rates…')) ?></p>
                    <?php else: ?>
                        <p class="hcc-muted"><?= $escaper->escapeHtml(__('Enter your zip code to see shipping rates.')) ?></p>
                    <?php endif; ?>
                <?php else: ?>
                    <?php foreach ($magewire->shippingMethods as $rate): ?>
                        <?php $methodKey = $rate['carrier_code'] . '_' . $rate['method_code']; ?>
                        <label class="hcc-shipping-rate">
                            <input type="radio"
                                   name="shipping_method"
                                   value="<?= $escaper->escapeHtmlAttr($methodKey) ?>"
                                   wire:model.change="selectedShippingMethodKey"/>
                            <span class="hcc-shipping-rate__price">$<?= $escaper->escapeHtml($rate['amount_formatted']) ?></span>
                            <span><?= $escaper->escapeHtml($rate['method_title']) ?></span>
                            <span class="hcc-muted-light"><?= $escaper->escapeHtml($rate['carrier_title']) ?></span>
                        </label>
                    <?php endforeach; ?>
                <?php endif; ?>
            </section>

            <section class="hcc-card hcc-section-gap" aria-labelledby="hcc-payment-title">
                <h2 id="hcc-payment-title" class="hcc-card__title"><?= $escaper->escapeHtml(__('Payment Method')) ?></h2>

                <label class="hcc-checkbox">
                    <input type="checkbox" wire:model.change="billingSameAsShipping"/>
                    <span><?= $escaper->escapeHtml(__('My billing and shipping address are the same')) ?></span>
                </label>

                <?php if ($magewire->paymentMethods === []): ?>
                    <p class="hcc-muted"><?= $escaper->escapeHtml(__('No payment methods are available.')) ?></p>
                <?php elseif (count($magewire->paymentMethods) > 1): ?>
                    <div class="hcc-payment-methods" role="radiogroup" aria-labelledby="hcc-payment-title">
                        <?php foreach ($magewire->paymentMethods as $method): ?>
                            <label class="hcc-payment-rate">
                                <input type="radio"
                                       name="payment_method"
                                       value="<?= $escaper->escapeHtmlAttr($method['code']) ?>"
                                       wire:model.change="selectedPaymentMethod"/>
                                <span><?= $escaper->escapeHtml($method['title']) ?></span>
                            </label>
                        <?php endforeach; ?>
                    </div>
                <?php endif; ?>

                <div class="hcc-stripe-wrap" x-show="stripeVisible" x-cloak>
                    <div id="stripe-payment-element" wire:ignore></div>
                    <p x-show="stripeError" x-text="stripeError" class="hcc-error" style="display:none" x-cloak></p>
                </div>
            </section>
        </div>

        <!-- Column 3: Order Summary -->
        <section class="hcc-card" aria-labelledby="hcc-summary-title">
            <h2 id="hcc-summary-title" class="hcc-card__title"><?= $escaper->escapeHtml(__('Order Summary')) ?></h2>

            <?php if ($magewire->totals): ?>
                <div class="hcc-summary-row">
                    <span><?= $escaper->escapeHtml(__('Cart Subtotal')) ?></span>
                    <span><?= $escaper->escapeHtml($magewire->totals['subtotal'] ?? '') ?></span>
                </div>
                <div class="hcc-summary-row">
                    <span><?= $escaper->escapeHtml(__('Shipping')) ?></span>
                    <span><?= $escaper->escapeHtml($magewire->totals['shipping'] ?? '') ?></span>
                </div>
                <div class="hcc-summary-row hcc-summary-row--total">
                    <span><?= $escaper->escapeHtml(__('Order Total Incl. Tax')) ?></span>
                    <span><?= $escaper->escapeHtml($magewire->totals['grand_total'] ?? '') ?></span>
                </div>
                <div class="hcc-summary-row">
                    <span><?= $escaper->escapeHtml(__('Order Total Excl. Tax')) ?></span>
                    <span><?= $escaper->escapeHtml($magewire->totals['grand_total_excl_tax'] ?? '') ?></span>
                </div>
            <?php endif; ?>

            <p class="hcc-cart-heading">
                <?= $escaper->escapeHtml(__('%1 ITEM(S) IN CART', (int) ($magewire->totals['items_count'] ?? count($magewire->cartItems)))) ?>
            </p>

            <?php foreach ($magewire->cartItems as $item): ?>
                <div class="hcc-cart-item"
                     wire:key="cart-item-<?= (int) $item['item_id'] ?>"
                     x-data="initHccCartItemRow"
                     data-item-id="<?= (int) $item['item_id'] ?>">
                    <div class="hcc-cart-item__img-wrap hcc-cart-placeholder"></div>
                    <div>
                        <div class="hcc-item-name"><?= $escaper->escapeHtml($item['name']) ?></div>
                        <div><?= $escaper->escapeHtml($item['row_total']) ?></div>
                        <div class="hcc-cart-item__qty">
                            <input type="number"
                                   min="1"
                                   value="<?= $escaper->escapeHtmlAttr((string) $item['qty']) ?>"
                                   @change="updateQty"/>
                            <button type="button"
                                    class="hcc-remove"
                                    @click="removeItem"
                                    aria-label="<?= $escaper->escapeHtmlAttr(__('Remove item')) ?>">
                                ✕
                            </button>
                        </div>
                    </div>
                </div>
            <?php endforeach; ?>

            <?php foreach ($magewire->agreements as $agreement): ?>
                <label class="hcc-checkbox">
                    <input type="checkbox"
                           value="<?= (int) $agreement['id'] ?>"
                           wire:model="agreementIds"/>
                    <span><?= /* @noEscape */ $agreement['content'] ?: $escaper->escapeHtml($agreement['name']) ?></span>
                </label>
            <?php endforeach; ?>

            <button type="button"
                    class="hcc-btn-place"
                    @click="submitOrder"
                    wire:loading.attr="disabled"
                    :disabled="isSubmitting">
                <?= $escaper->escapeHtml(__('PLACE ORDER')) ?>
            </button>
        </section>
    </div>
</div>
