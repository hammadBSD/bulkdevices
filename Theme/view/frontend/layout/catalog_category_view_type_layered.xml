<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="catalog.leftnav">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">BSD_Theme::category/layered.phtml</argument>
            </action>
        </referenceBlock>
        <!-- AjaxLayer moves category.products into layer.category.products; keep SEO below products + pagination -->
        <move element="bd.category.seo" destination="content" after="layer.category.products"/>
    </body>
</page>
