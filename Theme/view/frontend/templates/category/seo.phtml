<?php
declare(strict_types=1);

/** @var \Magento\Catalog\Block\Category\View $block */
/** @var \BSD\Theme\ViewModel\Plp|null $plpViewModel */
$plpViewModel = $block->getData('plp_view_model');
$category = $block->getCurrentCategory();
$bottomText = $category ? (string) $category->getData('category_text_bottom') : '';
if ($bottomText === '' || !$plpViewModel) {
    return;
}
?>
<section class="bd-category-seo is-collapsed" id="bd-category-seo">
    <div class="bd-category-seo__inner">
        <div class="bd-category-seo__content" id="bd-category-seo-content">
            <?= /* @noEscape */ $plpViewModel->filterCategoryContent($bottomText) ?>
        </div>
        <button type="button"
                class="bd-category-seo__toggle"
                id="bd-category-seo-toggle"
                aria-expanded="false"
                aria-controls="bd-category-seo-content">
            <span class="bd-category-seo__toggle-label"
                  data-more="<?= $block->escapeHtmlAttr(__('Show more')) ?>"
                  data-less="<?= $block->escapeHtmlAttr(__('Show less')) ?>">
                <?= $block->escapeHtml(__('Show more')) ?>
            </span>
        </button>
    </div>
</section>
