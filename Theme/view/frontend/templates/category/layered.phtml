<?php
/** @var \Magento\LayeredNavigation\Block\Navigation $block */
$layerConfig = '{}';
if (class_exists(\Mageplaza\LayeredNavigation\Helper\Data::class)) {
    $mpHelper = $this->helper(\Mageplaza\LayeredNavigation\Helper\Data::class);
    $layerConfig = $mpHelper->getLayerConfiguration($block->getFilters());
}
?>
<?php if ($block->canShowBlock()): ?>
<div class="bd-filters block filter" id="layered-filter-block">
    <div class="bd-filters__mobile-head">
        <h2 class="bd-filters__mobile-title"><?= $block->escapeHtml(__('SHOPPING OPTIONS')) ?></h2>
        <button type="button"
                class="bd-filters__close"
                id="bd-plp-filter-close"
                aria-label="<?= $block->escapeHtmlAttr(__('Close')) ?>">×</button>
    </div>
    <h2 class="bd-filters__title"><?= $block->escapeHtml(__('Filters')) ?></h2>
    <div class="block-content filter-content"
         data-mage-init='{"mpLayer": <?= /* @noEscape */ $layerConfig ?>}'>
        <?= $block->getChildHtml('state') ?>
        <?php if ($block->getLayer()->getState()->getFilters()): ?>
            <div class="block-actions filter-actions">
                <a href="<?= $block->escapeUrl($block->getClearUrl()) ?>" class="action clear filter-clear">
                    <span><?= $block->escapeHtml(__('Clear All')) ?></span>
                </a>
            </div>
        <?php endif; ?>
        <?php $wrapOptions = false; ?>
        <?php foreach ($block->getFilters() as $filter): ?>
            <?php if ($filter->getItemsCount()): ?>
                <?php
                $filterLabel = $filter->getName();
                if ($filter->getRequestVar() === 'cat') {
                    $currentCategory = $block->getLayer()->getCurrentCategory();
                    if ($currentCategory) {
                        $filterLabel = $currentCategory->getName();
                    }
                }
                ?>
                <?php if (!$wrapOptions): ?>
                    <div class="filter-options" id="narrow-by-list">
                    <?php $wrapOptions = true; endif; ?>
                <div class="bd-filter-panel filter-options-item active"
                     data-filter="<?= $block->escapeHtmlAttr($filter->getRequestVar()) ?>">
                    <div class="bd-filter-panel__title filter-options-title"><?= $block->escapeHtml($filterLabel) ?></div>
                    <div class="filter-options-content">
                        <?= /* @noEscape */ $block->getChildBlock('renderer')->setFilter($filter)->render($filter) ?>
                    </div>
                </div>
            <?php endif; ?>
        <?php endforeach; ?>
        <?php if ($wrapOptions): ?></div><?php endif; ?>
    </div>
</div>
<?php endif; ?>
