?>
<section class="bd-pdp-overview" aria-labelledby="bd-pdp-overview-title">
    <div class="bd-pdp-overview__tabs" role="tablist">
        <span class="bd-pdp-overview__tab is-active" role="tab" aria-selected="true" id="bd-pdp-overview-title">
            <?= $block->escapeHtml(__('Product Overview')) ?>
        </span>
    </div>

    <div class="bd-pdp-overview__panel">
        <h2 class="bd-pdp-overview__heading"><?= $block->escapeHtml($block->getOverviewHeading()) ?></h2>
        <p class="bd-pdp-overview__intro"><?= $block->escapeHtml($block->getOverviewIntro()) ?></p>

        <div class="bd-pdp-overview__spec">
            <div class="bd-pdp-overview__spec-head"><?= $block->escapeHtml(__('Technical Specification')) ?></div>
            <table class="bd-pdp-overview__spec-table">
                <tbody>
                <?php foreach ($specs as $row): ?>
                    <tr>
                        <th scope="row"><?= $block->escapeHtml($row['label']) ?></th>
                        <td><?= $block->escapeHtml($row['value']) ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </div>

        <h3 class="bd-pdp-overview__subheading"><?= $block->escapeHtml(__('Product Description')) ?></h3>
        <div class="bd-pdp-overview__description">
            <?php
            $rawDescription = trim((string) $_product->getDescription());
            if ($rawDescription !== '' && strip_tags($rawDescription) !== $rawDescription):
                echo /* @noEscape */ $rawDescription;
            else:
                ?>
                <p><?= $block->escapeHtml($description !== '' ? $description : (string) $_product->getName()) ?></p>
            <?php endif; ?>
        </div>

        <h3 class="bd-pdp-overview__subheading"><?= $block->escapeHtml($block->getWhyChooseHeading()) ?></h3>
        <ul class="bd-pdp-overview__benefits">
            <li><?= $block->escapeHtml(__('Safeguarding Your Investment: %1 %2, Only with Us', $block->getPartNumber(), $block->getBrandName())) ?></li>
            <li><?= $block->escapeHtml(__('Easy Returns & Fast Delivery')) ?></li>
        </ul>

        <p class="bd-pdp-overview__lowest">
            <?= $block->escapeHtml($block->getLowestPriceHtml()) ?>
            <a class="bd-pdp-overview__buy-now" href="#product-addtocart"><?= $block->escapeHtml(__('Buy Now')) ?></a>.
        </p>
    </div>
</section>
